# 编辑器层行尾与编码规范（与 .gitattributes 配套）。
# 背景：ISSUE-P1-02 整改期间曾出现编辑工具将 LF 文件整文件改写为 CRLF 的事故，
# 本文件让 IDE 与 AI 工具在写入文件时默认使用 LF，从源头杜绝 CRLF 再产生。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts,java,py,xml,pro,properties,toml,yml,yaml}]
indent_style = space

[*.py]
indent_size = 4

[*.tab]
indent_style = tab
