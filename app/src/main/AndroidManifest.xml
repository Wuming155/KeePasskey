<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 官方反欺诈加固（API 31+，minSdk 36 无兼容负担）：配合各敏感 Activity 的
         setHideOverlayWindows(true) 屏蔽其它应用的 TYPE_APPLICATION_OVERLAY 悬浮窗
         覆盖敏感窗口，防御 cloak-and-dagger 类 overlay 攻击——官方明确 FLAG_SECURE
         不覆盖该攻击面（developer.android.com/security/fraud-prevention/activities）。 -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.KeePasskey">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KeePasskey">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Credential Manager 凭据注册与断言交互 Activity (exported=false) -->
        <activity
            android:name=".passkey.PasskeyCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasskeyAssertionActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasswordFillActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasswordSaveActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- Credential Manager 链式解锁落地 Activity（锁库 Action 点选后由系统拉起，解锁成功回传凭据候选） -->
        <activity
            android:name=".passkey.CredentialUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统自动填充链式解锁落地 Activity（认证数据集点选后由系统拉起，解锁成功 finish 触发框架重发填充请求） -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统自动填充「已解锁分支」二次确认落地 Activity (TASK-11：认证数据集点选后拉起，
             用户二次确认成功返回 RESULT_OK 后框架才真正写入凭据值) -->
        <activity
            android:name=".autofill.AutofillConfirmActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- Android 16+ Credential Manager 系统凭据提供者服务 -->
        <service
            android:name=".passkey.KeePasskeyCredentialProviderService"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider_service" />
        </service>

        <!-- 传统系统自动填充服务 (AutofillService) 兼容层 -->
        <service
            android:name=".autofill.KeePasskeyAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>

</manifest>
