<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ISSUE-P3-94（审计 F-20）：清单权限口径的三条裁决（逐条附核实证据）。
         ① **不删除** `ACCESS_NETWORK_STATE` / `USE_BIOMETRIC`（AC① 未采纳）：
            二者是**本模块自身**的运行期需求（网络状态读取 / 生物识别），若改为依赖第三方库的
            传递声明，库一旦调整清单本应用即静默失去权限并在运行期抛 `SecurityException`
            ——属脆弱耦合；且证据表明**合并产物中并无重复条目**（release 合并清单中各出现一次，
            合并器已去重），故「冗余」只存在于源文件层面，删除无收益而有风险。
         ② `USE_FINGERPRINT` 加 `tools:node="remove"`（AC② 采纳）：该权限已被 API 28 弃用，
            仅由 `androidx.biometric` 的**旧版 FingerprintManager 兼容路径**注入；
            minSdk 36 ⇒ 该路径永不执行，保留只会扩大「已弃用权限」面。
         ③ **保留** `CAMERA`（AC③）：由 zxing 注入用于扫码取景，不在本清单干涉。 -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 官方反欺诈加固（API 31+，minSdk 36 无兼容负担）：配合各敏感 Activity 的
         setHideOverlayWindows(true) 屏蔽其它应用的 TYPE_APPLICATION_OVERLAY 悬浮窗
         覆盖敏感窗口，防御 cloak-and-dagger 类 overlay 攻击——官方明确 FLAG_SECURE
         不覆盖该攻击面（developer.android.com/security/fraud-prevention/activities）。 -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- ISSUE-P3-18：Android 13+（minSdk 36 全覆盖）通知为运行时权限，未声明则系统直接丢弃
         全部通知；声明后由 MainActivity 经 RequestPermission 契约请求一次，拒绝即静默降级。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ISSUE-P2-74（审计 E6）：**最小包可见性声明**。
         本应用以「浏览器委派」判定自动填充的 webDomain 归属，需读取**调用方包名**对应的签名证书指纹
         （`AutofillOriginResolver.callingAppCertSha256Hex` → `BrowserSigningFingerprints` / DAL 校验）。
         Android 11+ 的包可见性默认过滤 `getPackageInfo()`（官方《软件包可见性过滤》：受影响方法含
         `getPackageInfo()`，非自动可见包须经 `<queries>` 声明），未声明即抛 `NameNotFoundException`
         → 指纹恒为 null → 浏览器白名单与 DAL 校验**双双恒 false**，web 域候选整体失效
         （方向 fail-closed，无泄露，但功能不可用）。
         声明口径（**最小必要，不使用 `QUERY_ALL_PACKAGES`**）：
         ① `https` VIEW intent —— 按官方推荐的「intent 签名」方式使全部浏览器可见；
         ② 与 `BrowserSigningFingerprints.TRUSTED` **逐一对应**的显式 `<package>`（白名单新增浏览器时
            必须同步本清单，该一致性由单测 `PackageVisibilityQueriesWiringTest` 锁定）。
         边界（如实声明）：**非浏览器**调用方（任意应用）无法枚举，其指纹读取仍会失败并按 fail-closed
         处理，展示侧如实标注「不可读」而不伪造摘要。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <!-- TASK-139：应用选择器（黑名单 / 条目「关联应用」）需让用户按**应用名**指认目标应用，
             其数据源是 `queryIntentActivities(MAIN + LAUNCHER)`（见 `InstalledAppsCatalog`）。
             官方口径下查询其它已安装应用须经 `<queries>` 声明，这里用 **MAIN + LAUNCHER 的 intent
             签名**使「有桌面入口的应用」可见——它是 `QUERY_ALL_PACKAGES` 的**最小替代**：
             既无须申请该受限权限（Play 需审核）与更窄的可见面（仅用户可见的应用，而非全部进程），
             也无须维护一份会随时间漂移的 `<package>` 白名单。
             边界（如实声明）：无桌面入口的组件（系统服务 / 纯 SDK 集成方）**不在**选择器列表内，
             其包名仍可经选择器内的手工输入兜底添加，功能不因此缺失。 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.KeePasskey">
        <!-- ISSUE-P3-85 ①：唯一**无权限保护**的 exported 组件（启动器入口）。
             launchMode=singleTask + taskAffinity="" 用于消除「任意应用反复拉起 / 清任务栈」的
             DoS 与 UI 干扰面；配套回归约束（不得消费外部 extra）由
             ExportedComponentHygieneTest 锁定——本组件不得新增任何 intent 数据消费。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KeePasskey">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Credential Manager 凭据注册与断言交互 Activity (exported=false) -->
        <activity
            android:name=".passkey.PasskeyCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasskeyAssertionActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasswordFillActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasswordSaveActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- Credential Manager 链式解锁落地 Activity（锁库 Action 点选后由系统拉起，解锁成功回传凭据候选） -->
        <activity
            android:name=".passkey.CredentialUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统自动填充链式解锁落地 Activity（认证数据集点选后由系统拉起；解锁成功后链入
             AutofillPickerActivity 并原样转发其认证结果——框架不会在解锁后自动重发填充请求，
             故必须由本次认证结果携带真实 Dataset，见 ISSUE-P2-86） -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统自动填充「已解锁分支」二次确认落地 Activity (TASK-11：认证数据集点选后拉起，
             用户二次确认成功返回 RESULT_OK 后框架才真正写入凭据值) -->
        <activity
            android:name=".autofill.AutofillConfirmActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- Android 16+ Credential Manager 系统凭据提供者服务 -->
        <service
            android:name=".passkey.KeePasskeyCredentialProviderService"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider_service" />
        </service>

        <!-- ISSUE-P3-40：自动填充「手动选择器」落地 Activity（全库搜索兜底；由填充数据集的
             认证 PendingIntent 拉起，回传 AutofillManager.EXTRA_AUTHENTICATION_RESULT） -->
        <activity
            android:name=".autofill.AutofillPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统系统自动填充服务 (AutofillService) 兼容层 -->
        <service
            android:name=".autofill.KeePasskeyAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- ISSUE-P3-71：TOTP 扫码取景窗口——继承 zxing 默认 CaptureActivity 并强制 FLAG_SECURE +
             反悬浮窗覆盖，防止含密钥种子的二维码取景画面被截屏 / 录屏 / 多任务缩略图捕获。
             声明属性与 zxing 库默认声明保持一致（见合并清单）。 -->
        <activity
            android:name=".security.SecureCaptureActivity"
            android:exported="false"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
    </application>

</manifest>
