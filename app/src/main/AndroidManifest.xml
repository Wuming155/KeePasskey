<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ISSUE-P3-94（审计 F-20）：清单权限口径的三条裁决（逐条附核实证据）。
         ① **不删除** `ACCESS_NETWORK_STATE` / `USE_BIOMETRIC`（AC① 未采纳）：
            二者是**本模块自身**的运行期需求（网络状态读取 / 生物识别），若改为依赖第三方库的
            传递声明，库一旦调整清单本应用即静默失去权限并在运行期抛 `SecurityException`
            ——属脆弱耦合；且证据表明**合并产物中并无重复条目**（release 合并清单中各出现一次，
            合并器已去重），故「冗余」只存在于源文件层面，删除无收益而有风险。
         ② `USE_FINGERPRINT` 加 `tools:node="remove"`（AC② 采纳）：该权限已被 API 28 弃用，
            仅由 `androidx.biometric` 的**旧版 FingerprintManager 兼容路径**注入；
            minSdk 36 ⇒ 该路径永不执行，保留只会扩大「已弃用权限」面。
         ③ **显式声明** `CAMERA`（ISSUE-P3-319：原由 zxing-embedded 清单传递注入，
            移除该依赖后改由本清单显式声明——运行期需求不依赖第三方库传递声明的
            同一裁决口径；运行时权限经 `ActivityResultContracts.RequestPermission` 请求）。 -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ISSUE-P3-319：CAMERA 显式声明后需配套硬件特征声明（原由 zxing 清单传递注入）；
         required=false：无相机设备（ChromeOS 大屏等）仍可安装，扫码功能按权限拒绝路径如实降级。 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- 官方反欺诈加固（API 31+，minSdk 36 无兼容负担）：配合各敏感 Activity 的
         setHideOverlayWindows(true) 屏蔽其它应用的 TYPE_APPLICATION_OVERLAY 悬浮窗
         覆盖敏感窗口，防御 cloak-and-dagger 类 overlay 攻击——官方明确 FLAG_SECURE
         不覆盖该攻击面（developer.android.com/security/fraud-prevention/activities）。 -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- ISSUE-P3-18：Android 13+（minSdk 36 全覆盖）通知为运行时权限，未声明则系统直接丢弃
         全部通知；声明后由 MainActivity 经 RequestPermission 契约请求一次，拒绝即静默降级。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ISSUE-P2-74（审计 E6）：**最小包可见性声明**。
         本应用以「浏览器委派」判定自动填充的 webDomain 归属，需读取**调用方包名**对应的签名证书指纹
         （`AutofillOriginResolver.callingAppCertSha256Hex` → `BrowserSigningFingerprints` / DAL 校验）。
         Android 11+ 的包可见性默认过滤 `getPackageInfo()`（官方《软件包可见性过滤》：受影响方法含
         `getPackageInfo()`，非自动可见包须经 `<queries>` 声明），未声明即抛 `NameNotFoundException`
         → 指纹恒为 null → 浏览器白名单与 DAL 校验**双双恒 false**，web 域候选整体失效
         （方向 fail-closed，无泄露，但功能不可用）。
         声明口径（**最小必要，不使用 `QUERY_ALL_PACKAGES`**）：
         ① `https` VIEW intent —— 按官方推荐的「intent 签名」方式使全部浏览器可见；
         ② 与 `BrowserSigningFingerprints.TRUSTED` **逐一对应**的显式 `<package>`（白名单新增浏览器时
            必须同步本清单，该一致性由单测 `PackageVisibilityQueriesWiringTest` 锁定）。
         边界（如实声明）：**非浏览器**调用方（任意应用）无法枚举，其指纹读取仍会失败并按 fail-closed
         处理，展示侧如实标注「不可读」而不伪造摘要。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <!-- TASK-139：应用选择器（黑名单 / 条目「关联应用」）需让用户按**应用名**指认目标应用，
             其数据源是 `queryIntentActivities(MAIN + LAUNCHER)`（见 `InstalledAppsCatalog`）。
             官方口径下查询其它已安装应用须经 `<queries>` 声明，这里用 **MAIN + LAUNCHER 的 intent
             签名**使「有桌面入口的应用」可见——它是 `QUERY_ALL_PACKAGES` 的**最小替代**：
             既无须申请该受限权限（Play 需审核）与更窄的可见面（仅用户可见的应用，而非全部进程），
             也无须维护一份会随时间漂移的 `<package>` 白名单。
             边界（如实声明）：无桌面入口的组件（系统服务 / 纯 SDK 集成方）**不在**选择器列表内，
             其包名仍可经选择器内的手工输入兜底添加，功能不因此缺失。 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.KeePasskey">
        <!-- ISSUE-P1-238（2026-09-21 真机实测）：摘除 WorkManager 的 androidx.startup
             initializer——它会在 ContentProvider 阶段（**早于 Application.onCreate**）
             构造 WorkManagerImpl（打开 Room 数据库 + 建立系统任务调度器 + ForceStopRunnable
             对账），真机实测占冷启动 **0.41 s**，而凭据提供者只有约 3.0 s 应答预算。
             摘除后 WorkManager 改由 `MainApplication.workManagerConfiguration` 按需初始化
             （首个真实调用方是已下沉到后台作用域的 `PeriodicSyncScheduler.applySavedSchedule`）。
             保留同一 InitializationProvider 中的其它 initializer（如 ProfileInstaller）。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- ISSUE-P3-85 ①：唯一**无权限保护**的 exported 组件（启动器入口）。
             launchMode=singleTask + taskAffinity="" 用于消除「任意应用反复拉起 / 清任务栈」的
             DoS 与 UI 干扰面；配套回归约束（不得消费外部 extra）由
             ExportedComponentHygieneTest 锁定——本组件不得新增任何 intent 数据消费。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KeePasskey">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ISSUE-P3-298 ①：「打开方式」外部打开入口——文件管理器 / 云盘对 `.kdbx` 选择
             「打开方式」时承接 ACTION_VIEW / ACTION_SEND。导入到既有  `importExternalDatabase`
             链路（与页内 SAF 选择器同一入口）后拉起主界面进入解锁流程。
             安全边界：本页是有意新增的受控数据消费入口（与 MainActivity 的「不消费任何外部
             intent 数据」裁决互不冲突）——只接受 VIEW/SEND、只接受 content/file、只接受
             `.kdbx` 文件名，非法输入一律拒绝回落；白名单登记见 ExportedComponentHygieneTest。 -->
        <activity
            android:name=".OpenVaultEntryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.KeePasskey">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- .kdbx 无标准 MIME：文件管理器普遍按 octet-stream 提供；x-kdbx 覆盖
                     部分云盘显式标注的形态。不登记更宽的通配 MIME（最小可达性原则）。 -->
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-kdbx" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-kdbx" />
            </intent-filter>
        </activity>

        <!-- Credential Manager 凭据注册与断言交互 Activity (exported=false) -->
        <activity
            android:name=".passkey.PasskeyCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasskeyAssertionActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasswordFillActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <activity
            android:name=".passkey.PasswordSaveActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- Credential Manager 链式解锁落地 Activity（锁库 Action 点选后由系统拉起，解锁成功回传凭据候选） -->
        <activity
            android:name=".passkey.CredentialUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统自动填充链式解锁落地 Activity（认证数据集点选后由系统拉起；解锁成功后经 PD-05
             路由链入 AutofillPickerActivity 或 AutofillConfirmActivity 并原样转发其认证结果
             ——框架不会在解锁后自动重发填充请求，故必须由本次认证结果携带真实 Dataset，
             见 ISSUE-P2-86 / PD-05 候选 C） -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统自动填充「已解锁分支」二次确认落地 Activity (TASK-11：认证数据集点选后拉起，
             用户二次确认成功返回 RESULT_OK 后框架才真正写入凭据值) -->
        <activity
            android:name=".autofill.AutofillConfirmActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- Android 16+ Credential Manager 系统凭据提供者服务 -->
        <service
            android:name=".passkey.KeePasskeyCredentialProviderService"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider_service" />
        </service>

        <!-- ISSUE-P3-40：自动填充「手动选择器」落地 Activity（全库搜索兜底；由填充数据集的
             认证 PendingIntent 拉起，回传 AutofillManager.EXTRA_AUTHENTICATION_RESULT） -->
        <activity
            android:name=".autofill.AutofillPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- ISSUE-P3-324：旧版无障碍自动填充通道（系统自动填充框架不可用时的兜底）。
             exported=true + BIND_ACCESSIBILITY_SERVICE 权限保护（系统绑定必需，
             第三方无法拉起）；开关在应用内自动填充设置页，默认关闭（双闸门）。 -->
        <service
            android:name=".autofill.legacy.LegacyAutofillAccessibilityService"
            android:exported="true"
            android:label="@string/autofill_legacy_accessibility_title"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/legacy_autofill_accessibility_service" />
        </service>

        <!-- ISSUE-P3-324：旧版无障碍通道的条目选择器（通知拉起；受保护窗口，同框架选择器） -->
        <activity
            android:name=".autofill.legacy.LegacyFillPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />

        <!-- 传统系统自动填充服务 (AutofillService) 兼容层 -->
        <service
            android:name=".autofill.KeePasskeyAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- ISSUE-P3-319：原 ISSUE-P3-71 的 SecureCaptureActivity（zxing CaptureActivity 加固壳）
             已随 zxing-android-embedded 移除；TOTP 取景改为编辑页窗口内的受保护 Compose
             对话框 TotpScanDialog（加固面等效迁移见其 KDoc 与批次文档）。 -->
    </application>

</manifest>
