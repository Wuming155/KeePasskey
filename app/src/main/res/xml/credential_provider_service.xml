<?xml version="1.0" encoding="utf-8"?>
<!--
    官方契约（developer.android.com/identity/sign-in/credential-provider）：
    1. 根元素必须为 <credential-provider>（框架 CredentialProviderInfo 按SERVICE_META_DATA
       解析此资源，XML 必须含 credential-provider 标签）；
    2. <capabilities> 是系统做凭据类型路由匹配的依据——缺失将导致 password/passkey
       请求永远无法路由到本 provider；
    3. settingsActivity 与 autofill-service 侧各自独立声明（官方要求两处均设置）。
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsSubtitle="@string/app_name"
    android:settingsActivity="com.keepasskey.app.MainActivity">
    <capabilities>
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
        <!--
            兼容性占位（参考项目 Monica 实证，见 docs/references/Monica-架构分析.md §passkey）：
            官方文档只列 `androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL`（androidx 公开 API 中的
            常量值）；不带 androidx 前缀的 `android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL` 在
            AOSP / AndroidX 公开 API 里查不到对应常量。但**非 Pixel 的厂商 ROM**（Samsung / Xiaomi /
            OPPO 早期 ROM，含本机这类 LineageOS/Xiaomi 设备）的 Credential Manager 实现会按
            两种字符串匹配 provider——Monica 删掉这行后「部分用户的 passkey 直接消失」。
            在严格遵守 AOSP 规范的设备上它会被忽略，在认旧名字的设备上它避免 passkey 不可用。
            删除本行前必须先在目标设备上复测浏览器/应用的通行密钥创建与填充。
        -->
        <capability name="android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
