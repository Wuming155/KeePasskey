<?xml version="1.0" encoding="utf-8"?>
<!--
    Wave 14 全局网络安全配置：全站强制 HTTPS。

    - base-config 对所有域名生效：cleartextTrafficPermitted="false" 禁止任何明文 HTTP 流量；
    - 信任锚仅系统 CA（certificates src="system"）：显式声明并固化 targetSdk 28+ 的平台默认行为，
      同时拒绝用户安装的 CA 证书参与信任链，防范本地证书注入中间人（密码管理器场景的实质安全增益）；
    - 不设任何 domain-config 明文豁免——本应用仅支持正规公网商业云服务（不支持自建内网服务器），
      证书验证完全依赖系统默认 CA 链，且不做任何证书固定（避免阻碍云厂商常规证书轮换）。

    与 OkHttp 层 SyncHttpClientFactory 的 TLS-only ConnectionSpec（排除 CLEARTEXT）
    形成「平台层 + 传输层」双层防御。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
