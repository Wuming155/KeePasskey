<?xml version="1.0" encoding="utf-8"?>
<!--
  debug 变体专属清单（ISSUE-P2-245）：只声明设备侧用例
  `DialogWindowHardeningDeviceTest` 的宿主 Activity。

  为什么必须落在**被测应用**的清单里（而非 app/src/androidTest/AndroidManifest.xml）：
  `Instrumentation.startActivitySync` 拒绝启动另一包/进程的组件——宿主若属测试 APK 包
  （com.keepasskey.app.test），真机上 `ActivityScenario.launch` 会抛
  `Intent in process com.keepasskey resolved to different process com.keepasskey.test`，
  且用例在另一进程里组合出的对话框窗口测试进程读不到（2026-09-21 真机实测，如实留痕）。

  release 变体不含本文件 ⇒ 生产包（含其清单）一行未改。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="${applicationId}.test" />
    </queries>

    <application android:networkSecurityConfig="@xml/network_security_config">
        <receiver
            android:name="com.keepasskey.app.sync.P3_628ScenarioReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.keepasskey.debug.P3_628_SETUP_MAIN_PROCESS" />
                <action android:name="com.keepasskey.debug.P3_628_ENABLE_PROBE" />
                <action android:name="com.keepasskey.debug.P3_628_ASSERT_NOTICE" />
                <action android:name="com.keepasskey.debug.P3_628_CLEANUP" />
            </intent-filter>
        </receiver>
        <activity
            android:name="com.keepasskey.app.security.DialogWindowHardeningHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <!--
          ISSUE-P1-631：漂移对话框宿主（最小 UI 测试基建）。挂载**生产**组合件
          `ExternalModificationDialogHost`，由生产单例协调器状态流驱动；用例以无障碍节点
          真实点击「合并后保存 / 以本地版本为准 / 稍后处理」等按钮。
        -->
        <activity
            android:name="com.keepasskey.app.ui.DriftDialogHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <activity
            android:name="com.keepasskey.app.ui.EntryDetailDeviceHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <activity
            android:name="com.keepasskey.app.ui.HistoryDetailDeviceHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <activity
            android:name="com.keepasskey.app.ui.EntryEditDeviceHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <!--
          ISSUE-P3-643：编辑页脏位与离页确认的设备验收宿主。组合件仍是生产的 EntryEditScreen，
          差别仅在于把生产的 EntryEditViewModel 暴露给用例（图标 tile 无 contentDescription，
          连续选择同一图标无法经无障碍树点击）。
        -->
        <activity
            android:name="com.keepasskey.app.ui.EntryEditDirtyConfirmDeviceHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <activity
            android:name="com.keepasskey.app.ui.SyncConflictDeviceHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <!--
          ISSUE-P3-644：分组图标写反馈与只读菜单/批量入口的设备验收宿主。
          挂载**生产**组合件 `VaultListContent`（分组行菜单 / 图标选择对话框 / 批量顶栏）
          与 `VaultListActionController`，消息走生产的 AppSnackbarChannel →
          AppGlobalSnackbarHost；用例以无障碍节点真实点击菜单项与图标。
        -->
        <activity
            android:name="com.keepasskey.app.ui.VaultGroupFeedbackDeviceHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
        <!--
          ISSUE-P2-651/652：云端同步设置页的真实 UI 验收宿主。挂载的是**生产**组合件
          `CloudSyncScreen`（含 `SecurePasswordField` 与离页 `DisposableEffect`），只把
          生产 `SettingsSyncController` 暴露给用例，以便在测试进程内用真实 HTTPS 接收方
          统计请求、并在 A 的测连在途时改存 B。
        -->
        <activity
            android:name="com.keepasskey.app.ui.CloudSyncDeviceHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.KeePasskey" />
    </application>

</manifest>
