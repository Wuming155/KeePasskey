<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 AndroidTest APK 信任本地 HTTPS 验收安装的用户 CA；正式应用清单不读取此策略。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
