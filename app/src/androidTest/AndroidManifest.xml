<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_SET_ORIGIN" />
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_QUERY_CANDIDATE_CREDENTIALS" />

    <!--
      ISSUE-P2-73 AC③（设备侧实测自动填充认证链路）。

      本清单只服务于 instrumented 用例：声明一个**独立包名**（测试 APK 包 `com.keepasskey.app.test`）
      的自动填充客户端 Activity。自动填充框架对「自动填充服务自己所在包名」不生效，
      故驱动认证链路必须有一个本应用之外的真实客户端——测试 APK 的包名与 uid 均不同于
      被测应用（`com.keepasskey`），语义上等价于「另一个应用调用了本填充服务」。

      - `exported="true"`：客户端进程与测试进程不同包，需允许外部（测试）显式启动；
      - `stateAlwaysHidden`：不自动弹输入法，避免键盘遮挡系统填充下拉与后续 a11y 取点；
      - Activity 自身在 `onPostResume` 内主动调用 `AutofillManager.requestAutofill`，
        因此无需测试进程持有其 View 引用（跨进程亦可驱动）。
    -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <provider
            android:name="com.keepasskey.app.data.repository.SafCreationProbeDocumentsProvider"
            android:authorities="${applicationId}.saf594"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <activity
            android:name="com.keepasskey.app.data.repository.SafCreationProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name="com.keepasskey.app.autofill.AutofillClientActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.keepasskey.app.autofill.AutofillClientBActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.p2_620_b"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <!--
          Credential Manager「保存」链路的真实客户端（同上：测试 APK 自己的包名与 uid，
          语义等价于第三方应用调用 CredentialManager.createCredential 触发系统保存提示）。
          `exported="true"` 使真机复现时可由 adb 直接拉起，无需先跑 gradle 用例。
        -->
        <activity
            android:name="com.keepasskey.app.passkey.CredentialSaveClientActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <!-- Independent browser-origin test caller for real system Credential Manager A/B requests. -->
        <activity
            android:name="com.keepasskey.app.passkey.CredentialBrowserGetClientActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:process=":p2_620_browser"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.keepasskey.app.passkey.CredentialBrowserPrepareReceiver"
            android:exported="true"
            android:process=":p2_620_prepare" />

        <!-- 系统 PendingIntent A/B 身份验收专用；只接收应用生成的合成令牌与假数据。 -->
        <activity
            android:name="com.keepasskey.app.autofill.LockedSaveRequestProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <provider
            android:name="com.keepasskey.app.autofill.LockedSaveRequestHolderProvider"
            android:authorities="${applicationId}.p2_603_holder"
            android:exported="true"
            android:process=":p2_603_holder" />
        <activity
            android:name="com.keepasskey.app.autofill.LockedSaveRequestHolderActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>

</manifest>
