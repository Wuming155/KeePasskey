# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
buildSrc/build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio / IntelliJ
*.iml
.idea/
*.ipr
*.iws
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# AI 编码工具工作区（Plan / Spec 等本地过程文件，属工具产物，不入库；
# 项目计划与结论一律落 docs/ 下的正式文档）
.trae/
.vscode/
# Keystore files（ISSUE-P3-09 / ZT-20 AC5 补齐）
# 已覆盖：*.jks / *.keystore / keystore.properties（keystore.properties.example 为模板，须入库，
# 故此处只忽略精确文件名而不做 keystore.properties.* 通配）。
# 本次补齐 PKCS#12（*.p12/*.pfx，含 release.jks 之外的常见发布密钥格式）与
# PEM/*.key 私钥/证书容器扩展名，避免发布密钥或自签私钥误入库。
*.jks
*.keystore
keystore.properties
*.p12
*.pfx
*.pem
*.key
# 例外：仓库内两处**公开**本地联调自签证书（不含私钥）为既有 tracked 测试材料，
# 显式保留可入库能力，避免重新生成后无法提交；
# 对应私钥 certs/key.pem、certs/minio/private.key 由 tools/local-sync/.gitignore 单独忽略。
!sync/src/test/resources/live/cert.pem
!tools/local-sync/certs/cert.pem

# Google Services (e.g. APIs or Firebase)
google-services.json
GoogleService-Info.plist

# Android Profiling & Dumps
*.hprof

# NDK
obj/

# Kotlin
*.kotlin/
.kotlin

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Crashlytics / Firebase
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Temp/backup/diff files
*~
*.bak
*.swp
*.tmp
*.diff
*.patch
.git_broken_backup/

# 参考项目（整个目录忽略）
参考项目/
测试项目/

# 本地手工测试库与凭据（严禁入库）
KeePasskey测试/
KeePasskey测试_backup/
*_backup/

# Python 工具链产物（tools/local-sync 等本地联调脚本）
__pycache__/
*.py[cod]
.venv/
venv/
