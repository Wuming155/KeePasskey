<?xml version="1.0" encoding="UTF-8"?>
<!--
  TASK-20（P3）：OWASP Dependency-Check 误报 suppression 白名单。

  维护纪律：
  1. 首次扫描完成后，凡经人工核实为误报的条目（如 GPL 传输依赖、测试作用域、
     无漏洞利用面的 CVE），按 dependency-check 报告中的 suppression 按钮生成条目追加于此；
  2. 每条 suppression 必须同时登记到 docs/STATUS.md §2 对应 TASK 备注与
     docs/FINDINGS_TRACKER.md（若涉及发现项），并注明「核实依据 / 责任人 / 日期」；
  3. 上游修复或依赖升级后及时移除失效 suppression 条目，防止白名单静默掩盖真实漏洞。
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- 误报条目示例（按需启用）：
    <suppress>
        <notes><![CDATA[手动核实：...不属于攻击面 / 无漏洞利用路径 / 测试作用域，登记于 TASK-20]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.example/.*$</packageUrl>
        <cve>CVE-YYYY-XXXXX</cve>
    </suppress>
    -->
</suppressions>
